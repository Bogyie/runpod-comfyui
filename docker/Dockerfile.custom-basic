# syntax=docker/dockerfile:1.7

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONUNBUFFERED=1 \
    COMFY_HOME=/opt/comfy \
    COMFYUI_DIR=/opt/comfy/ComfyUI \
    COMFY_VENV=/opt/comfy/venv \
    PATH=/opt/comfy/venv/bin:$PATH

ARG COMFYUI_MANAGER_REF=e4c5401dd5da96e901f8b8cb8a7eca63e13e8ee5
ARG KJNODES_REF=8a225698ae7cb87632817419f83a64ecf571fe76
ARG RGTHREE_REF=738105af5fb14e96fbecaf406dc356e284797e8c
ARG CRYSTOOLS_REF=2f18256c5b5063937106f29a8e0a7db3ae3869b7

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY scripts/install_custom_nodes.sh scripts/verify_protected_packages.py /opt/bootstrap/scripts/

RUN --mount=type=cache,id=pip-custom-basic,target=/root/.cache/pip \
    chmod +x /opt/bootstrap/scripts/install_custom_nodes.sh /opt/bootstrap/scripts/verify_protected_packages.py && \
    /opt/bootstrap/scripts/install_custom_nodes.sh \
      ComfyUI-Manager https://github.com/Comfy-Org/ComfyUI-Manager.git "${COMFYUI_MANAGER_REF}" \
      ComfyUI-KJNodes https://github.com/kijai/ComfyUI-KJNodes.git "${KJNODES_REF}" \
      rgthree-comfy https://github.com/rgthree/rgthree-comfy.git "${RGTHREE_REF}" \
      ComfyUI-Crystools https://github.com/crystian/ComfyUI-Crystools.git "${CRYSTOOLS_REF}"

COPY scripts/ /opt/bootstrap/scripts/

RUN chmod +x /opt/bootstrap/scripts/*.sh /opt/bootstrap/scripts/*.py && \
    /opt/bootstrap/scripts/cleanup-image.sh && \
    "${COMFY_VENV}/bin/python" /opt/bootstrap/scripts/verify_image.py \
      --stage custom-basic \
      --node ComfyUI-Manager \
      --node ComfyUI-KJNodes \
      --node rgthree-comfy \
      --node ComfyUI-Crystools \
      --path /opt/bootstrap/baked-custom-nodes
