# syntax=docker/dockerfile:1.7

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONUNBUFFERED=1 \
    COMFY_HOME=/opt/comfy \
    COMFYUI_DIR=/opt/comfy/ComfyUI \
    COMFY_VENV=/opt/comfy/venv \
    PATH=/opt/comfy/venv/bin:$PATH

ARG COMFYUI_MANAGER_REF=2b40deba7d04afeee29ee70c88f6c336e43dc9ca
ARG KJNODES_REF=4d46ac107c33ed8a3d181b8776ede66498583380
ARG RGTHREE_REF=6b76ee6f2c5a007710b5a16f97c94330d6ecc871
ARG CRYSTOOLS_REF=2f18256c5b5063937106f29a8e0a7db3ae3869b7

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY scripts/install_custom_nodes.sh scripts/verify_protected_packages.py scripts/cleanup-image.sh /opt/bootstrap/scripts/

RUN --mount=type=cache,id=pip-custom-basic,target=/var/cache/buildkit-pip \
    chmod +x /opt/bootstrap/scripts/install_custom_nodes.sh /opt/bootstrap/scripts/verify_protected_packages.py /opt/bootstrap/scripts/cleanup-image.sh && \
    PIP_CACHE_DIR=/var/cache/buildkit-pip /opt/bootstrap/scripts/install_custom_nodes.sh \
      ComfyUI-Manager https://github.com/Comfy-Org/ComfyUI-Manager.git "${COMFYUI_MANAGER_REF}" \
      ComfyUI-KJNodes https://github.com/kijai/ComfyUI-KJNodes.git "${KJNODES_REF}" \
      rgthree-comfy https://github.com/rgthree/rgthree-comfy.git "${RGTHREE_REF}" \
      ComfyUI-Crystools https://github.com/crystian/ComfyUI-Crystools.git "${CRYSTOOLS_REF}" && \
    /opt/bootstrap/scripts/cleanup-image.sh

RUN /opt/bootstrap/scripts/cleanup-image.sh && \
    "${COMFY_VENV}/bin/python" /opt/bootstrap/scripts/verify_image.py \
      --stage custom-basic \
      --node ComfyUI-Manager \
      --node ComfyUI-KJNodes \
      --node rgthree-comfy \
      --node ComfyUI-Crystools \
      --path /opt/bootstrap/baked-custom-nodes

EXPOSE 8443/tcp
