# syntax=docker/dockerfile:1.7

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONUNBUFFERED=1 \
    COMFY_HOME=/opt/comfy \
    COMFYUI_DIR=/opt/comfy/ComfyUI \
    COMFY_VENV=/opt/comfy/venv \
    PATH=/opt/comfy/venv/bin:$PATH

ARG CONTROLNET_AUX_REF=e8b689a513c3e6b63edc44066560ca5919c0576e
ARG IMPACT_PACK_REF=429d0159ad429e64d2b3916e6e7be9c22d025c3c
ARG SAPIENS2_EASY_REF=51958bb75a2ee7644018d55b4f2b6f6d535101ad
ARG DEPTH_ANYTHING_V3_REF=6b08cf418dff47430a72e07d0eec8fdb07d464b1

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY scripts/install_custom_nodes.sh scripts/verify_protected_packages.py scripts/cleanup-image.sh /opt/bootstrap/scripts/

RUN --mount=type=cache,id=pip-custom-image,target=/var/cache/buildkit-pip \
    chmod +x /opt/bootstrap/scripts/install_custom_nodes.sh /opt/bootstrap/scripts/verify_protected_packages.py /opt/bootstrap/scripts/cleanup-image.sh && \
    PIP_CACHE_DIR=/var/cache/buildkit-pip /opt/bootstrap/scripts/install_custom_nodes.sh \
      comfyui_controlnet_aux https://github.com/Fannovel16/comfyui_controlnet_aux.git "${CONTROLNET_AUX_REF}" \
      ComfyUI-Impact-Pack https://github.com/ltdrdata/ComfyUI-Impact-Pack.git "${IMPACT_PACK_REF}" \
      ComfyUI-Sapiens2-Easy https://github.com/Bogyie/ComfyUI-Sapiens2-Easy.git "${SAPIENS2_EASY_REF}" \
      ComfyUI-DepthAnythingV3 https://github.com/PozzettiAndrea/ComfyUI-DepthAnythingV3.git "${DEPTH_ANYTHING_V3_REF}" && \
    /opt/bootstrap/scripts/cleanup-image.sh

COPY scripts/ /opt/bootstrap/scripts/

RUN chmod +x /opt/bootstrap/scripts/*.sh /opt/bootstrap/scripts/*.py && \
    /opt/bootstrap/scripts/cleanup-image.sh && \
    "${COMFY_VENV}/bin/python" /opt/bootstrap/scripts/verify_image.py \
      --stage custom-image \
      --node comfyui_controlnet_aux \
      --node ComfyUI-Impact-Pack \
      --node ComfyUI-Sapiens2-Easy \
      --node ComfyUI-DepthAnythingV3 \
      --path /opt/bootstrap/baked-custom-nodes
