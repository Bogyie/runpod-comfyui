# syntax=docker/dockerfile:1.7

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONUNBUFFERED=1 \
    COMFY_HOME=/opt/comfy \
    COMFYUI_DIR=/opt/comfy/ComfyUI \
    COMFY_VENV=/opt/comfy/venv \
    PATH=/opt/comfy/venv/bin:$PATH

ARG VIDEO_HELPER_SUITE_REF=4ee72c065db22c9d96c2427954dc69e7b908444b
ARG SEEDVR2_VIDEO_UPSCALER_REF=4490bd1f482e026674543386bb2a4d176da245b9
ARG WAN_VIDEO_WRAPPER_REF=088128b224242e110d3906c6750e9a3a348a659b
ARG LTX_VIDEO_REF=229437c6b65796d6a7a63ae34be2bd5ba31fa543

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY scripts/install_custom_nodes.sh scripts/verify_protected_packages.py scripts/cleanup-image.sh /opt/bootstrap/scripts/

RUN --mount=type=cache,id=pip-custom-video,target=/var/cache/buildkit-pip \
    chmod +x /opt/bootstrap/scripts/install_custom_nodes.sh /opt/bootstrap/scripts/verify_protected_packages.py /opt/bootstrap/scripts/cleanup-image.sh && \
    PIP_CACHE_DIR=/var/cache/buildkit-pip /opt/bootstrap/scripts/install_custom_nodes.sh \
      ComfyUI-VideoHelperSuite https://github.com/kosinkadink/ComfyUI-VideoHelperSuite.git "${VIDEO_HELPER_SUITE_REF}" \
      ComfyUI-SeedVR2_VideoUpscaler https://github.com/numz/ComfyUI-SeedVR2_VideoUpscaler.git "${SEEDVR2_VIDEO_UPSCALER_REF}" \
      ComfyUI-WanVideoWrapper https://github.com/kijai/ComfyUI-WanVideoWrapper.git "${WAN_VIDEO_WRAPPER_REF}" \
      ComfyUI-LTXVideo https://github.com/Lightricks/ComfyUI-LTXVideo.git "${LTX_VIDEO_REF}" && \
    /opt/bootstrap/scripts/cleanup-image.sh

COPY scripts/ /opt/bootstrap/scripts/

RUN chmod +x /opt/bootstrap/scripts/*.sh /opt/bootstrap/scripts/*.py && \
    /opt/bootstrap/scripts/cleanup-image.sh && \
    "${COMFY_VENV}/bin/python" /opt/bootstrap/scripts/verify_image.py \
      --stage custom-video \
      --node ComfyUI-VideoHelperSuite \
      --node ComfyUI-SeedVR2_VideoUpscaler \
      --node ComfyUI-WanVideoWrapper \
      --node ComfyUI-LTXVideo \
      --path /opt/bootstrap/baked-custom-nodes

EXPOSE 8443/tcp
