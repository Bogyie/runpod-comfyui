# syntax=docker/dockerfile:1.7
# Experimental P0 core candidate; no stable promotion or RunPod production certification.
ARG BASE_IMAGE
FROM ${BASE_IMAGE} AS gpu-base

ARG UV_VERSION
ARG TORCH_BACKEND
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_LINK_MODE=copy \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    PATH=/opt/runtime/venv/bin:$PATH

RUN python -m pip install --no-cache-dir "uv==${UV_VERSION}" && \
    uv venv --python /usr/local/bin/python /opt/runtime/venv
COPY gpu.txt /opt/locks/gpu.txt
RUN --mount=type=cache,id=rebuild-pip-cu128,target=/root/.cache/uv \
    uv pip install --python /opt/runtime/venv/bin/python \
      --require-hashes --only-binary=:all: --torch-backend "${TORCH_BACKEND}" \
      --requirement /opt/locks/gpu.txt && \
    python -c 'import torch, torchvision, torchaudio, xformers; assert torch.version.cuda == "12.8"; print(torch.__version__, torch.version.cuda)'

# CLI dependencies have their own prefix and never inherit the GPU/host site.
FROM ${BASE_IMAGE} AS tools-builder
ARG UV_VERSION
ENV UV_LINK_MODE=copy
RUN python -m pip install --no-cache-dir "uv==${UV_VERSION}" && \
    uv venv --python /usr/local/bin/python /opt/comfyctl/venv
COPY tools.txt /opt/locks/tools.txt
RUN --mount=type=cache,id=rebuild-pip-tools,target=/root/.cache/uv \
    uv pip install --python /opt/comfyctl/venv/bin/python --require-hashes \
      --only-binary=:all: --requirement /opt/locks/tools.txt && \
    uv pip check --python /opt/comfyctl/venv/bin/python

# Each worker installs against only the GPU base, its own lock and installer.
# Host/ComfyUI/SDK/adapter changes do not invalidate these package layers.
FROM gpu-base AS worker-builder
COPY link_gpu_packages.py install_worker_envs.py /opt/probe/

FROM worker-builder AS worker-sam3
ARG TORCH_BACKEND
COPY worker-install/sam3/ /opt/locks/worker-install/
RUN --mount=type=cache,id=rebuild-pip-cu128,target=/root/.cache/uv \
    python /opt/probe/install_worker_envs.py --backend "${TORCH_BACKEND}" \
      --definitions /opt/locks/worker-install/manifest.json

FROM worker-builder AS worker-depth-anything-v3
ARG TORCH_BACKEND
COPY worker-install/depth-anything-v3/ /opt/locks/worker-install/
RUN --mount=type=cache,id=rebuild-pip-cu128,target=/root/.cache/uv \
    python /opt/probe/install_worker_envs.py --backend "${TORCH_BACKEND}" \
      --definitions /opt/locks/worker-install/manifest.json

FROM worker-builder AS worker-itools
ARG TORCH_BACKEND
COPY worker-install/itools/ /opt/locks/worker-install/
RUN --mount=type=cache,id=rebuild-pip-cu128,target=/root/.cache/uv \
    python /opt/probe/install_worker_envs.py --backend "${TORCH_BACKEND}" \
      --definitions /opt/locks/worker-install/manifest.json

FROM worker-builder AS worker-kjnodes
ARG TORCH_BACKEND
COPY worker-install/kjnodes/ /opt/locks/worker-install/
RUN --mount=type=cache,id=rebuild-pip-cu128,target=/root/.cache/uv \
    python /opt/probe/install_worker_envs.py --backend "${TORCH_BACKEND}" \
      --definitions /opt/locks/worker-install/manifest.json

FROM worker-builder AS worker-video-helper-suite
ARG TORCH_BACKEND
COPY worker-install/video-helper-suite/ /opt/locks/worker-install/
RUN --mount=type=cache,id=rebuild-pip-cu128,target=/root/.cache/uv \
    python /opt/probe/install_worker_envs.py --backend "${TORCH_BACKEND}" \
      --definitions /opt/locks/worker-install/manifest.json

FROM gpu-base AS host
ARG TORCH_BACKEND
ENV COMFYCTL_REQUIRE_ISOLATION=1
RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg git libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
COPY host.txt /opt/locks/host.txt
RUN --mount=type=cache,id=rebuild-pip-cu128,target=/root/.cache/uv \
    uv pip install --python /opt/runtime/venv/bin/python \
      --require-hashes --only-binary=:all: --torch-backend "${TORCH_BACKEND}" \
      --requirement /opt/locks/host.txt && \
    uv pip check --python /opt/runtime/venv/bin/python
COPY apply_comfy_env_patch.py managed_metadata.py /opt/probe/
RUN python -c 'import importlib.util, pathlib, subprocess, sys; root = pathlib.Path(importlib.util.find_spec("comfy_env").origin).parent; subprocess.run([sys.executable, "/opt/probe/apply_comfy_env_patch.py", str(root)], check=True)'
COPY ComfyUI/ /opt/probe/ComfyUI/
WORKDIR /opt/probe/ComfyUI
# P0 core CPU startup only: custom-node and GPU gates are intentionally separate.
CMD ["python", "main.py", "--cpu", "--use-pytorch-cross-attention", "--disable-all-custom-nodes", "--listen", "0.0.0.0", "--port", "8188"]

# Native comfy-env workers in separately locked venvs. Only immutable GPU
# artifacts are linked from the already verified stack; no host sys.path leaks.
FROM host AS worker-probe
ARG WORKER_ATTENTION=pytorch
COPY worker-locks/ /opt/locks/workers/
COPY --link --from=worker-sam3 /opt/workers/sam3-nodes/ /opt/workers/sam3-nodes/
COPY --link --from=worker-depth-anything-v3 /opt/workers/depthanythingv3-nodes/ /opt/workers/depthanythingv3-nodes/
COPY --link --from=worker-itools /opt/workers/itools-workernodes/ /opt/workers/itools-workernodes/
COPY --link --from=worker-kjnodes /opt/workers/kjnodes-workernodes/ /opt/workers/kjnodes-workernodes/
COPY --link --from=worker-video-helper-suite /opt/workers/videohelpersuite-workernodes/ /opt/workers/videohelpersuite-workernodes/
COPY --link worker-identities/ /opt/workers/
RUN for prefix in /opt/workers/*; do python /opt/probe/apply_comfy_env_patch.py "$prefix/lib/python3.11/site-packages/comfy_env"; done
COPY worker-nodes/ /opt/probe/ComfyUI/custom_nodes/
ENV COMFYCTL_WORKER_ROOT=/opt/workers \
    COMFY_ENV_ROOT=/opt/worker-state \
    COMFYCTL_WORKER_ATTENTION=${WORKER_ATTENTION} \
    VHS_FORCE_FFMPEG_PATH=/usr/bin/ffmpeg
CMD ["python", "main.py", "--cpu", "--use-pytorch-cross-attention", "--listen", "0.0.0.0", "--port", "8188"]

# P2 runtime candidate: no boot-time package installation, immutable /opt,
# service uid 1000, and managed storage separated from source/environment.
FROM worker-probe AS runtime-probe
RUN useradd --uid 1000 --user-group --no-create-home --home-dir /workspace/state/home comfy
COPY --link --from=tools-builder /opt/comfyctl/venv/ /opt/comfyctl/venv/
COPY tools.txt /opt/locks/tools.txt
COPY cli-source/ /opt/comfyctl/src/comfyctl/
COPY runtime-nodes/ /opt/probe/ComfyUI/custom_nodes/
COPY --chmod=0755 comfyctl /usr/local/bin/comfyctl
COPY runtime/ /opt/runtime/control/
ENV COMFYCTL_SERVICE_UID=1000 \
    COMFYCTL_COMFY_ROOT=/opt/probe/ComfyUI \
    COMFYCTL_STORAGE_DIR=/workspace/storage \
    COMFYCTL_METADATA_CACHE=/workspace/cache/metadata \
    COMFY_ENV_ROOT=/workspace/state/comfy-env \
    HOME=/workspace/state/home \
    XDG_CACHE_HOME=/workspace/cache \
    HF_HOME=/workspace/cache/huggingface \
    TORCH_HOME=/workspace/cache/torch
ENTRYPOINT ["/usr/local/bin/python", "-I", "/opt/runtime/control/entrypoint.py"]
CMD ["--use-pytorch-cross-attention", "--listen", "0.0.0.0", "--port", "8188"]
