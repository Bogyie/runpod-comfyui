# syntax=docker/dockerfile:1.7

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    COMFY_HOME=/opt/comfy \
    COMFYUI_DIR=/opt/comfy/ComfyUI \
    COMFY_VENV=/opt/comfy/venv

ARG COMFYUI_3D_PACK_REF=main
ARG SAPIENS2_EASY_REF=main

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY scripts/ /opt/bootstrap/scripts/

RUN --mount=type=cache,id=pip-custom-3d,target=/root/.cache/pip \
    chmod +x /opt/bootstrap/scripts/*.sh /opt/bootstrap/scripts/*.py && \
    /opt/bootstrap/scripts/install_custom_nodes.sh \
      ComfyUI-3D-Pack https://github.com/MrForExample/ComfyUI-3D-Pack.git "${COMFYUI_3D_PACK_REF}" \
      ComfyUI-Sapiens2-Easy https://github.com/Bogyie/ComfyUI-Sapiens2-Easy.git "${SAPIENS2_EASY_REF}"

RUN /opt/bootstrap/scripts/cleanup-image.sh && \
    "${COMFY_VENV}/bin/python" /opt/bootstrap/scripts/verify_image.py \
      --stage custom-3d \
      --node ComfyUI-3D-Pack \
      --node ComfyUI-Sapiens2-Easy \
      --path /opt/bootstrap/baked-custom-nodes
