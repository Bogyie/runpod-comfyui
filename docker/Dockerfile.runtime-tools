# syntax=docker/dockerfile:1.7

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONUNBUFFERED=1 \
    COMFY_HOME=/opt/comfy \
    COMFYUI_DIR=/opt/comfy/ComfyUI \
    COMFY_VENV=/opt/comfy/venv \
    PATH=/opt/comfy/venv/bin:$PATH \
    WORKSPACE_DIR=/workspace \
    STORAGE_DIR=/workspace/storage \
    COMFYUI_PORT=8188 \
    COMFYUI_HOST=127.0.0.1 \
    FILEBROWSER_PORT=8080 \
    FILEBROWSER_HOST=127.0.0.1 \
    FILEBROWSER_BASEURL=/files \
    FILEBROWSER_ROOT=/ \
    CADDY_HTTPS_PORT=8443 \
    CADDY_BASIC_AUTH_USER=runpod \
    CADDY_BASIC_AUTH_PASSWORD=runpod-comfyui \
    CLI_ARGS=

ARG CADDY_VERSION=2.11.4
ARG FILEBROWSER_VERSION=2.63.15
ARG RUNPODCTL_VERSION=2.4.0
ARG HUGGINGFACE_HUB_VERSION=1.19.0
ARG CADDY_LINUX_AMD64_SHA256=527fbf917c39189a1e3b31d34fa955601680b2d5c8055d2a87b8b9588dec7bb9
ARG FILEBROWSER_LINUX_AMD64_SHA256=2e781227d626d8b8ba533b77bdd6cb3a8cf70e014af1a8a3966a13a901a0a951
ARG RUNPODCTL_LINUX_AMD64_SHA256=3efb8bbebdfec8b63f8a3a0c99c806f4d348da2a3d96fd879c350eb14b5299ad

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN --mount=type=cache,id=apt-runtime-tools,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=aptlists-runtime-tools,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      gpg \
      git \
      jq \
      openssl \
      openssh-client \
      supervisor \
      tar \
      wget \
      xz-utils && \
    mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
    chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list && \
    apt-get update && apt-get install -y --no-install-recommends gh

RUN curl -fsSL -o /tmp/caddy.tar.gz \
      "https://github.com/caddyserver/caddy/releases/download/v${CADDY_VERSION}/caddy_${CADDY_VERSION}_linux_amd64.tar.gz" && \
    echo "${CADDY_LINUX_AMD64_SHA256}  /tmp/caddy.tar.gz" | sha256sum -c - && \
    tar -C /usr/local/bin -xzf /tmp/caddy.tar.gz caddy && \
    chmod +x /usr/local/bin/caddy && \
    rm /tmp/caddy.tar.gz

RUN curl -fsSL -o /tmp/filebrowser.tar.gz \
      "https://github.com/filebrowser/filebrowser/releases/download/v${FILEBROWSER_VERSION}/linux-amd64-filebrowser.tar.gz" && \
    echo "${FILEBROWSER_LINUX_AMD64_SHA256}  /tmp/filebrowser.tar.gz" | sha256sum -c - && \
    tar -C /usr/local/bin -xzf /tmp/filebrowser.tar.gz filebrowser && \
    chmod +x /usr/local/bin/filebrowser && \
    rm /tmp/filebrowser.tar.gz

RUN curl -fsSL -o /usr/local/bin/runpodctl \
      "https://github.com/runpod/runpodctl/releases/download/v${RUNPODCTL_VERSION}/runpodctl-linux-amd64" && \
    echo "${RUNPODCTL_LINUX_AMD64_SHA256}  /usr/local/bin/runpodctl" | sha256sum -c - && \
    chmod +x /usr/local/bin/runpodctl

RUN --mount=type=cache,id=pip-runtime-tools,target=/root/.cache/pip \
    "${COMFY_VENV}/bin/python" -m pip install "huggingface_hub[cli]==${HUGGINGFACE_HUB_VERSION}"

COPY scripts/verify_protected_packages.py /opt/bootstrap/scripts/

RUN chmod +x /opt/bootstrap/scripts/verify_protected_packages.py && \
    "${COMFY_VENV}/bin/python" /opt/bootstrap/scripts/verify_protected_packages.py \
      verify \
      /opt/bootstrap/protected-package-manifest.json && \
    "${COMFY_VENV}/bin/python" -m pip freeze > /opt/bootstrap/base-requirements.lock

COPY scripts/ /opt/bootstrap/scripts/
COPY rootfs/ /

RUN chmod +x /opt/bootstrap/scripts/*.sh /opt/bootstrap/scripts/*.py && \
    chmod +x /etc/services.d/*/run && \
    /opt/bootstrap/scripts/cleanup-image.sh && \
    command -v git && \
    command -v curl && \
    command -v wget && \
    command -v runpodctl && \
    command -v gh && \
    command -v caddy && \
    command -v filebrowser && \
    command -v supervisord && \
    test -x /opt/bootstrap/scripts/runpod-supervisord-entrypoint.sh && \
    test -x /opt/bootstrap/scripts/runpod-runtime-init.sh && \
    test -f /etc/supervisor/supervisord.conf && \
    test -x /etc/services.d/comfyui/run && \
    test -x /etc/services.d/filebrowser/run && \
    test -x /etc/services.d/caddy/run && \
    (command -v hf || command -v huggingface-cli || test -x "${COMFY_VENV}/bin/hf" || test -x "${COMFY_VENV}/bin/huggingface-cli") && \
    "${COMFY_VENV}/bin/python" /opt/bootstrap/scripts/verify_image.py \
      --stage runtime-tools \
      --import huggingface_hub \
      --path /opt/bootstrap/base-requirements.lock

EXPOSE 8443/tcp

ENTRYPOINT ["/opt/bootstrap/scripts/runpod-supervisord-entrypoint.sh"]
CMD []
