#!/usr/bin/env bash
set -euo pipefail

WORKSPACE_DIR="${WORKSPACE_DIR:-/workspace}"
STORAGE_DIR="${STORAGE_DIR:-/workspace/storage}"
FILEBROWSER_HOST="${FILEBROWSER_HOST:-127.0.0.1}"
FILEBROWSER_PORT="${FILEBROWSER_PORT:-8080}"
FILEBROWSER_ROOT="${FILEBROWSER_ROOT:-/}"
FILEBROWSER_BASEURL="${FILEBROWSER_BASEURL:-/files}"
FILEBROWSER_DATABASE="${FILEBROWSER_DATABASE:-${STORAGE_DIR}/filebrowser/filebrowser.db}"

mkdir -p "${WORKSPACE_DIR}/logs" "$(dirname "${FILEBROWSER_DATABASE}")" "${FILEBROWSER_ROOT}"

exec >> "${WORKSPACE_DIR}/logs/filebrowser.log" 2>&1

if [[ ! -s "${FILEBROWSER_DATABASE}" ]]; then
  filebrowser config init --database "${FILEBROWSER_DATABASE}"
fi

filebrowser --database "${FILEBROWSER_DATABASE}" config set \
  --address "${FILEBROWSER_HOST}" \
  --port "${FILEBROWSER_PORT}" \
  --root "${FILEBROWSER_ROOT}" \
  --baseURL "${FILEBROWSER_BASEURL}" \
  --auth.method=noauth \
  --disableExec

exec filebrowser \
  --database "${FILEBROWSER_DATABASE}"
